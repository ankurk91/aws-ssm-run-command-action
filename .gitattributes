# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Image files
*.jpg binary
*.jpeg binary
*.png binary
*.ico binary

# Export ignores
.github export-ignore

# Built artifacts: no local diffs, collapsed in GitHub PRs, excluded from language statistics
dist/** -diff linguist-generated

# Collapse lockfile diffs in GitHub PRs
pnpm-lock.yaml linguist-generated
